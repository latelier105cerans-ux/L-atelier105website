# Web3Forms Access Key
# Get your key from https://web3forms.com
NUXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Nuxt Studio (visual editor at /_studio) — GitHub OAuth App
# Create it at https://github.com/settings/developers (on the latelier105cerans-ux account)
# Callback URL: https://<your-domain>/__nuxt_studio/auth/github
STUDIO_GITHUB_CLIENT_ID=your_client_id
STUDIO_GITHUB_CLIENT_SECRET=your_client_secret
